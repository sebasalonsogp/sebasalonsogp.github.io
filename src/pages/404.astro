---
import BlackHole from '../components/BlackHole.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../lib/format';

// docs/design-spec.md, "404": the line and a way back, with the black hole behind them.
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="This page does not exist."
  shareable={false}
>
  <section class="lost gut" aria-labelledby="lost-heading">
    <BlackHole eager />
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 id="lost-heading">This page fell past the event horizon.</h1>
      <a class="btn btn-primary" href={withBase('')}>
        Back to the system
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100svh;
    overflow: hidden;
  }

  .wrap {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 20px;
    justify-items: start;
    width: 100%;
  }

  h1 {
    margin: 0;
    max-width: 18ch;
    font-size: var(--s-h1);
    font-weight: 380;
    line-height: 1.07;
    letter-spacing: -0.012em;
  }
</style>
