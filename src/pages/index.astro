---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
---

<BaseLayout
  title="Portfolio — in progress"
  description="A personal portfolio focused on backend engineering, AI, machine learning, and data science."
>
  <div class="shell">
    <header>
      <p class="eyebrow">Personal portfolio · in progress</p>
      <h1>
        Backend engineering.
        <br />
        AI, ML & data science.
      </h1>
      <p class="intro">A space for the systems I build and the ideas I explore.</p>
      <a href="#work">View work</a>
    </header>

    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      {projects.length > 0 ? (
        <ul class="projects">
          {projects.map(({ data }) => (
            <li>
              <h3>{data.title}</h3>
              <p>{data.summary}</p>
              <p class="technologies">{data.technologies.join(' · ')}</p>
              {data.repositoryUrl && <a href={data.repositoryUrl}>Source code</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p>Project stories are being prepared.</p>
      )}
    </section>

    <footer>
      <p>This portfolio is taking shape. More soon.</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .shell {
    width: min(100% - 3rem, 64rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 9vw, 7rem);
  }

  header {
    max-width: 48rem;
  }

  .eyebrow,
  .technologies,
  footer {
    color: var(--color-text-muted);
  }

  .eyebrow {
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  h1 {
    margin-block: 1.5rem;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .intro {
    max-width: 42ch;
    margin-block-end: 2rem;
  }

  section {
    margin-block-start: 5rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--color-border);
  }

  .projects {
    display: grid;
    gap: 2rem;
    padding: 0;
    list-style: none;
  }

  footer {
    margin-block-start: 4rem;
    font-size: 0.875rem;
  }
</style>
