---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<BaseLayout
  title={`${site.name} — in progress`}
  description="A personal portfolio focused on backend engineering, AI, machine learning, and data science."
>
  <div class="shell">
    <header>
      <p class="eyebrow">Personal portfolio · in progress</p>
      <h1>
        Backend engineering.
        <br />
        AI, ML & data science.
      </h1>
      <p class="intro">A space for the systems I build and the ideas I explore.</p>
      <a href="#work">View work</a>
    </header>

    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      {projects.length > 0 ? (
        <ul class="projects">
          {projects.map(({ data }) => (
            <li>
              <h3>{data.title}</h3>
              <p>{data.summary}</p>
              <p class="technologies">{data.tech.join(' · ')}</p>
              <a href={`https://github.com/${data.repo}`}>Source code</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>Project stories are being prepared.</p>
      )}
    </section>

    <footer>
      <p>This portfolio is taking shape. More soon.</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--section-pad) var(--gutter-right) var(--section-pad) var(--gutter-left);
  }

  header {
    max-width: 48rem;
  }

  .technologies,
  footer {
    color: var(--dim);
    font-size: var(--s-small);
  }

  .eyebrow {
    font-family: var(--f-data);
    font-size: var(--s-cap);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  h1 {
    margin-block: var(--sp-5);
    font-size: var(--s-h1);
    font-weight: 380;
    line-height: 1.07;
    letter-spacing: -0.012em;
  }

  h2 {
    font-size: var(--s-h2);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: var(--s-h3);
    margin-block-end: var(--sp-2);
  }

  .intro {
    max-width: 42ch;
    margin-block-end: var(--sp-6);
    font-size: var(--s-lede);
    color: var(--dim);
  }

  section {
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-6);
    border-block-start: 1px solid var(--rule);
  }

  .projects {
    display: grid;
    gap: var(--sp-6);
    padding: 0;
    list-style: none;
  }

  footer {
    margin-block-start: var(--sp-7);
  }
</style>
