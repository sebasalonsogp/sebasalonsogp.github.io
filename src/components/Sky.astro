<div class="sky" data-sky aria-hidden="true">
  <div class="layer" data-sky-layer>
    <canvas data-sky-static></canvas>
    <canvas data-sky-stars></canvas>
  </div>
</div>

<script>
  import { mountSky } from '../features/sky/sky';

  const root = document.querySelector<HTMLElement>('[data-sky]');
  if (root) mountSky(root);
</script>

<style>
  .sky {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    pointer-events: none;
  }

  /* Extends past the viewport by the parallax margin (60 px, see sky.ts); parallax moves this
     layer with a transform, so the compositor does it without repainting. */
  .layer {
    position: absolute;
    inset: -60px;
    will-change: transform;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
</style>
