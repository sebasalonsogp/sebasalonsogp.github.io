---
import { statSync } from 'node:fs';
import { basename, join } from 'node:path';
import { site } from '../data/site';
import { withBase } from '../lib/format';
import ExternalLink from './ExternalLink.astro';
import Section from './Section.astro';

// The resume card downloads the PDF and says how big it is (read at build time).
const resumeKb = Math.max(
  1,
  Math.round(statSync(join(process.cwd(), 'public', site.resumePath)).size / 1024),
);
// Ten digits is a North American number: dial it with +1 so it works from abroad too.
const phoneDigits = site.phone.replace(/\D/g, '');
const phoneHref = `tel:${phoneDigits.length === 10 ? `+1${phoneDigits}` : phoneDigits}`;
---

<Section id="contact" title="Contact" fact={site.availability} class="contact">
  {/* Decorative; shown only once the black hole has drawn (src/features/blackhole). */}
  <figure class="bh" slot="backdrop" aria-hidden="true" hidden data-black-hole>
    <canvas></canvas>
    <figcaption>Ray-traced live in your browser</figcaption>
  </figure>
  <div class="ct-grid">
    <div class="ct-info">
      <div class="ct-item">
        <p class="label">Email</p>
        <p class="ct-addr" data-email-address>
          {site.email}
        </p>
        <div class="ct-acts">
          <button class="btn btn-primary" type="button" data-copy-email hidden>
            Copy email
          </button>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>
            Open in mail app
          </a>
          <span class="status" data-copy-status aria-live="polite"></span>
        </div>
      </div>
      <dl class="ct-dl">
        {site.showPhone && (
          <div>
            <dt class="label">Phone</dt>
            <dd>
              <a class="ct-tel" href={phoneHref}>
                {site.phone}
              </a>
            </dd>
          </div>
        )}
        <div>
          <dt class="label">Location</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </div>

    <div class="ct-side">
      <a class="ct-resume" href={withBase(site.resumePath)} download={basename(site.resumePath)}>
        <span class="ct-r-top">
          <span class="mono">Resume · PDF · {resumeKb} KB</span>
          <span class="ct-r-ico" aria-hidden="true">
            ↓
          </span>
        </span>
        <span class="ct-r-title">Download my resume</span>
      </a>
      <ul class="ct-links">
        <li>
          <ExternalLink href={site.linkedin.url}>
            <span>LinkedIn</span>
            <span class="mono">{site.linkedin.handle} ↗</span>
          </ExternalLink>
        </li>
        <li>
          <ExternalLink href={site.github.url}>
            <span>GitHub</span>
            <span class="mono">{site.github.handle} ↗</span>
          </ExternalLink>
        </li>
      </ul>
    </div>
  </div>
</Section>

<script>
  // The black hole loads only when Contact comes near, and only shows if it can draw.
  const blackHole = document.querySelector<HTMLElement>('[data-black-hole]');
  const contact = document.querySelector<HTMLElement>('#contact');
  if (blackHole && contact) {
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        near.disconnect();
        blackHole.dataset.pending = '';
        blackHole.hidden = false;
        void import('../features/blackhole/blackhole')
          .then(({ mountBlackHole }) => mountBlackHole(blackHole))
          .catch(() => null)
          .then((mounted) => {
            if (!mounted) blackHole.hidden = true;
          });
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(contact);
  }
</script>

<script>
  // Progressive enhancement: without JavaScript the address and the mail link remain.
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const address = document.querySelector<HTMLElement>('[data-email-address]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  if (button && address && status) {
    let timer: number | undefined;
    const say = (message: string) => {
      status.textContent = message;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => (status.textContent = ''), 2400);
    };
    const shortcut = /Mac|iPhone|iPad/.test(navigator.userAgent) ? '⌘C' : 'Ctrl+C';
    // Without clipboard access (older browsers, no permission) the address is selected instead.
    const select = () => {
      const range = document.createRange();
      range.selectNodeContents(address);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      say(`Selected. Press ${shortcut} to copy.`);
    };

    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(address.textContent?.trim() ?? '');
        say('Copied');
      } catch {
        select();
      }
    });
  }
</script>

<style>
  /* The black hole sits behind the contact column: a backdrop on the right on desktop, faded
     out under the text, and a banner above the heading on phones. */
  :global(.sec.contact) {
    position: relative;
    overflow: hidden;
  }

  :global(.sec.contact > .wrap) {
    position: relative;
    z-index: 1;
  }

  .bh {
    position: absolute;
    top: 50%;
    right: max(-80px, calc((100vw - 1120px) / 2 - 200px));
    z-index: 0;
    width: min(1080px, 82vw);
    margin: 0;
    pointer-events: none;
    transform: translateY(-44%);
  }

  .bh[data-pending] {
    visibility: hidden;
  }

  .bh canvas {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 22%, #000 46%);
  }

  .bh figcaption {
    position: absolute;
    right: 12%;
    bottom: 10%;
    font-size: var(--s-cap);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 34rem);
    gap: var(--sp-6);
    min-height: 560px;
    align-content: center;
  }

  @media (max-width: 900px) {
    .bh {
      position: relative;
      top: auto;
      right: auto;
      width: auto;
      margin: 0 calc(-1 * var(--gutter-right)) 8px calc(-1 * var(--gutter-left));
      transform: none;
    }

    .bh canvas {
      aspect-ratio: 4 / 3;
      mask-image: none;
    }

    .bh figcaption {
      position: static;
      margin-top: -8px;
      text-align: center;
    }

    .ct-grid {
      min-height: 0;
    }
  }

  .ct-info {
    display: grid;
    gap: 28px;
  }

  .ct-item {
    display: grid;
    gap: 10px;
  }

  .ct-item p {
    margin: 0;
  }

  .label {
    font-size: var(--s-small);
    color: var(--dim);
  }

  .ct-addr {
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    font-weight: 360;
    letter-spacing: -0.01em;
    word-break: break-all;
    user-select: all;
  }

  .ct-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .status {
    font-size: var(--s-small);
    color: var(--dim);
  }

  .ct-dl {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .ct-dl div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .ct-dl dd {
    margin: 0;
    font-size: 1.05rem;
  }

  .ct-tel {
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .ct-tel:hover {
    color: var(--sol);
  }

  .ct-side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  .ct-resume {
    display: grid;
    gap: var(--sp-2);
    padding: 22px 22px 20px;
    border: 1px solid var(--sol);
    border-radius: var(--radius-2);
    background: color-mix(in srgb, var(--sol) 8%, transparent);
    text-decoration: none;
    transition: background var(--dur-fast);
  }

  .ct-resume:hover {
    background: color-mix(in srgb, var(--sol) 15%, transparent);
  }

  .ct-r-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ct-r-top .mono {
    color: var(--sol);
  }

  .ct-r-ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--sol);
    color: var(--sol-ink);
    font-weight: 600;
  }

  .ct-r-title {
    font-family: var(--f-display);
    font-size: 1.7rem;
    font-weight: 380;
    line-height: 1.15;
  }

  .ct-links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .ct-links li {
    border-bottom: 1px solid var(--rule);
  }

  .ct-links :global(a) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px var(--sp-4);
    padding: 18px 4px;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .ct-links :global(a:hover span:first-child) {
    color: var(--sol);
  }
</style>
