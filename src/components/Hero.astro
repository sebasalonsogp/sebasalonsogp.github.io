---
import { site } from '../data/site';
import type { SystemData } from '../features/explorer/system';

interface Props {
  /** Project open on load (`/projects/<id>/`); its visit view is passed as the slot. */
  initialProject?: string | undefined;
  /** The explorer's data (projects in orbit order, labels), built at compile time. */
  system: SystemData;
}

const { initialProject, system } = Astro.props;
---

<!-- The explorer canvas fills this section once loaded (after first paint, only with WebGL2);
     its height is reserved so the layout does not shift when the scene arrives. -->
<section
  class:list={['hero gut', { visiting: initialProject }]}
  id="hero"
  aria-labelledby={initialProject ? 'visit-title' : 'hero-heading'}
  data-initial-project={initialProject}
  data-explorer-root
>
  <script
    is:inline
    type="application/json"
    data-explorer-system
    set:html={JSON.stringify(system)}
  />
  {initialProject ? (
    <div class="wrap visit-wrap">
      <slot />
    </div>
  ) : (
    <div class="intro wrap">
      <p class="eyebrow">{site.eyebrow}</p>
      <h1 id="hero-heading">
        {site.pitch.lead} <em>{site.pitch.emphasis}</em>
      </h1>
      <p class="lede">{site.lede}</p>
      <div class="ctas">
        <a class="btn" href="#projects">
          See the list instead
        </a>
      </div>
    </div>
  )}
</section>

<script>
  import { supportsWebGL2 } from '../features/explorer/support';

  // Three.js loads after the page has painted, so the hero text stays the largest paint, and
  // never loads without WebGL2: the readable hero and project list remain either way.
  // Project pages keep the plain visit panel until the explorer can frame a visit (Phase 4);
  // the system would otherwise sit behind the panel's text.
  const hero = document.querySelector<HTMLElement>(
    '[data-explorer-root]:not([data-initial-project])',
  );
  if (hero) {
    if (!supportsWebGL2()) {
      hero.dataset.explorer = 'unavailable';
    } else {
      hero.dataset.explorer = 'loading';
      const start = () =>
        import('../features/explorer/explorer')
          .then(({ mountExplorer }) => mountExplorer(hero))
          .catch(() => {
            hero.dataset.explorer = 'unavailable';
          });
      const whenIdle = () => {
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(start, { timeout: 2000 });
        } else {
          window.setTimeout(start, 200);
        }
      };
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    height: clamp(660px, 92vh, 900px);
    border-bottom: 1px solid var(--rule);
  }

  .hero.visiting {
    height: auto;
    min-height: clamp(660px, 92vh, 900px);
    padding-block: 104px var(--sp-7);
  }

  .visit-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Created by the explorer script, so not scoped to this component. Touch drags only turn
     the system horizontally; vertical swipes still scroll the page. */
  .hero :global(.system) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .hero :global(.system.is-over-planet) {
    cursor: pointer;
  }

  .hero :global(.system.is-dragging) {
    cursor: grabbing;
  }

  .hero :global(.explorer-labels) {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .hero :global(.planet-label),
  .hero :global(.star-label),
  .hero :global(.belt-label),
  .hero :global(.highlight-ring) {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
  }

  .hero :global(.planet-label) {
    display: grid;
    gap: 1px;
    justify-items: start;
    color: color-mix(in srgb, var(--ink) 90%, transparent);
    text-decoration: none;
    text-shadow: var(--halo);
    pointer-events: auto;
  }

  .hero :global(.planet-label.is-left) {
    justify-items: end;
    text-align: right;
  }

  .hero :global(.planet-label .name) {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.25;
    transition: color var(--dur-fast);
  }

  .hero :global(.planet-label .meta) {
    font-family: var(--f-data);
    font-size: var(--s-cap);
    line-height: 1.3;
    color: var(--dim);
  }

  .hero :global(.explorer-labels.is-compact .meta) {
    display: none;
  }

  .hero :global(.planet-label:hover .name),
  .hero :global(.planet-label:focus-visible .name),
  .hero :global(.planet-label.is-highlighted .name) {
    color: var(--sol);
  }

  .hero :global(.star-label) {
    width: 0;
    display: flex;
    justify-content: center;
    font-family: var(--f-data);
    font-size: var(--s-cap);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sol) 85%, transparent);
    text-shadow: var(--halo);
  }

  .hero :global(.belt-label) {
    font-family: var(--f-data);
    font-size: var(--s-cap);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .hero :global(.highlight-ring) {
    border: 1px solid color-mix(in srgb, var(--sol) 90%, transparent);
    border-radius: 50%;
  }

  /* The intro spans the content width; only its own text and buttons take the pointer, so
     the rest of the hero reaches the explorer underneath. */
  .intro {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    pointer-events: none;
    gap: 20px;
    justify-items: start;
  }

  .intro > * {
    max-width: 31rem;
    pointer-events: auto;
  }

  h1 {
    margin: 0;
    font-size: var(--s-h1);
    font-weight: 380;
    line-height: 1.07;
    letter-spacing: -0.012em;
  }

  em {
    font-style: italic;
    font-weight: 340;
    color: var(--sol);
  }

  .lede {
    margin: 0;
    max-width: 27rem;
    font-size: var(--s-lede);
    line-height: 1.55;
    color: var(--dim);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .hero {
      align-items: start;
      height: clamp(760px, 100svh, 880px);
      padding-top: 88px;
    }

    .intro {
      gap: 14px;
    }

    .lede {
      font-size: var(--s-body);
    }
  }
</style>
