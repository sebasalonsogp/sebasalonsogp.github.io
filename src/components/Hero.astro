---
import { site } from '../data/site';

interface Props {
  /** Project open on load (`/projects/<id>/`); its visit view is passed as the slot. */
  initialProject?: string | undefined;
}

const { initialProject } = Astro.props;
---

<!-- The explorer canvas fills this section once loaded (after first paint, only with WebGL2);
     its height is reserved so the layout does not shift when the scene arrives. -->
<section
  class:list={['hero gut', { visiting: initialProject }]}
  id="hero"
  aria-labelledby={initialProject ? 'visit-title' : 'hero-heading'}
  data-initial-project={initialProject}
  data-explorer-root
>
  {initialProject ? (
    <div class="wrap visit-wrap">
      <slot />
    </div>
  ) : (
    <div class="intro wrap">
      <p class="eyebrow">{site.eyebrow}</p>
      <h1 id="hero-heading">
        {site.pitch.lead} <em>{site.pitch.emphasis}</em>
      </h1>
      <p class="lede">{site.lede}</p>
      <div class="ctas">
        <a class="btn" href="#projects">
          See the list instead
        </a>
      </div>
    </div>
  )}
</section>

<script>
  import { supportsWebGL2 } from '../features/explorer/support';

  // Three.js loads after the page has painted, so the hero text stays the largest paint, and
  // never loads without WebGL2: the readable hero and project list remain either way.
  const hero = document.querySelector<HTMLElement>('[data-explorer-root]');
  if (hero) {
    if (!supportsWebGL2()) {
      hero.dataset.explorer = 'unavailable';
    } else {
      hero.dataset.explorer = 'loading';
      const start = () =>
        import('../features/explorer/explorer')
          .then(({ mountExplorer }) => mountExplorer(hero))
          .catch(() => {
            hero.dataset.explorer = 'unavailable';
          });
      const whenIdle = () => {
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(start, { timeout: 2000 });
        } else {
          window.setTimeout(start, 200);
        }
      };
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    height: clamp(660px, 92vh, 900px);
    border-bottom: 1px solid var(--rule);
  }

  .hero.visiting {
    height: auto;
    min-height: clamp(660px, 92vh, 900px);
    padding-block: 104px var(--sp-7);
  }

  .visit-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Created by the explorer script, so not scoped to this component. */
  .hero :global(.system) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
  }

  .intro {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .intro > * {
    max-width: 31rem;
  }

  h1 {
    margin: 0;
    font-size: var(--s-h1);
    font-weight: 380;
    line-height: 1.07;
    letter-spacing: -0.012em;
  }

  em {
    font-style: italic;
    font-weight: 340;
    color: var(--sol);
  }

  .lede {
    margin: 0;
    max-width: 27rem;
    font-size: var(--s-lede);
    line-height: 1.55;
    color: var(--dim);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 760px) {
    .hero {
      align-items: start;
      height: clamp(760px, 100svh, 880px);
      padding-top: 88px;
    }

    .intro {
      gap: 14px;
    }

    .lede {
      font-size: var(--s-body);
    }
  }
</style>
