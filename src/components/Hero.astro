---
import { site } from '../data/site';
import type { SystemData } from '../features/explorer/system';
import HowToRead from './HowToRead.astro';
import '../features/explorer/explorer.css';

interface Props {
  /** Project open on load (`/projects/<id>/`); its visit view is passed as the slot. */
  initialProject?: string | undefined;
  /** The explorer's data (projects in orbit order, labels), built at compile time. */
  system: SystemData;
}

const { initialProject, system } = Astro.props;

// What each encoding in the system means (concept's key).
const key = [
  {
    term: 'Surface',
    detail:
      'What kind of work: rocky for backend, banded for machine learning, ocean for data science, ice for math',
  },
  { term: 'Orbit', detail: 'Inner orbits are the most recent work' },
  { term: 'Ring', detail: 'A live demo you can land on' },
  { term: 'Size', detail: 'Lines of code' },
  { term: 'Moons', detail: 'Separately running services' },
  { term: 'Belt', detail: 'Earlier projects and coursework' },
];
---

<!-- The explorer canvas fills this section once loaded (after first paint, only with WebGL2);
     its height is reserved so the layout does not shift when the scene arrives. -->
<section
  class:list={['hero gut', { visiting: initialProject }]}
  id="hero"
  aria-labelledby={initialProject ? 'visit-title' : 'hero-heading'}
  data-initial-project={initialProject}
  data-explorer-root
>
  <script
    is:inline
    type="application/json"
    data-explorer-system
    set:html={JSON.stringify(system)}
  />
  {initialProject && (
    <div class="wrap visit-wrap">
      <slot />
    </div>
  )}
  <div class="intro wrap">
    <p class="eyebrow">{site.eyebrow}</p>
    {
      /* On project pages the project title is the page's h1; the pitch is shown there only
         after returning to the system. */
      initialProject ? (
        <p class="hero-title" id="hero-heading">
          {site.pitch.lead} <em>{site.pitch.emphasis}</em>
        </p>
      ) : (
        <h1 class="hero-title" id="hero-heading">
          {site.pitch.lead} <em>{site.pitch.emphasis}</em>
        </h1>
      )
    }
    <p class="lede">{site.lede}</p>
    <div class="ctas">
      {system.tour.length > 0 && (
        <button class="btn btn-primary tour-btn" type="button" data-tour-start>
          Take the 60-second tour
        </button>
      )}
      <a class="btn" href="#projects">
        See the list instead
      </a>
    </div>
  </div>
  <div class="hint">
    <div class="hint-row wrap">
      <span>Drag to turn · Select a world · Esc to return</span>
      <HowToRead summary="How to read the system" placement="up" items={key} />
    </div>
  </div>
</section>

<script>
  import { supportsWebGL2 } from '../features/explorer/support';

  const LOAD_FALLBACK_MS = 2500;

  // Three.js loads after the page has painted, so the hero text stays the largest paint, and
  // never loads without WebGL2: the readable hero and project list remain either way.
  // On project pages the static visit shows first and the explorer takes over as soon as the
  // page has loaded (no idle wait), opening that visit without a fly-in.
  const hero = document.querySelector<HTMLElement>('[data-explorer-root]');
  if (hero) {
    if (!supportsWebGL2()) {
      hero.dataset.explorer = 'unavailable';
    } else {
      hero.dataset.explorer = 'loading';
      const start = () =>
        import('../features/explorer/explorer')
          .then(({ mountExplorer }) => mountExplorer(hero))
          .catch(() => {
            hero.dataset.explorer = 'unavailable';
          });
      let started = false;
      const begin = () => {
        if (started) return;
        started = true;
        if (hero.dataset.initialProject) {
          start();
        } else if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(start, { timeout: 2000 });
        } else {
          window.setTimeout(start, 200);
        }
      };
      // After the page has loaded, or after a short wait if a slow image or video holds the
      // load event back.
      if (document.readyState === 'complete') begin();
      else {
        window.addEventListener('load', begin, { once: true });
        window.setTimeout(begin, LOAD_FALLBACK_MS);
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    height: clamp(660px, 92vh, 900px);
    border-bottom: 1px solid var(--rule);
    /* The closed visit panel waits just off the right edge; keep it from widening the page. */
    overflow-x: clip;
  }

  .hero.visiting {
    height: auto;
    min-height: clamp(660px, 92vh, 900px);
    padding-block: 104px var(--sp-7);
  }

  /* Instructions for the system: shown only once the explorer has mounted (it sets
     data-planets), so nobody reads about a system they cannot see. */
  .hint {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    padding: 16px var(--gutter-right) 18px var(--gutter-left);
    pointer-events: none;
  }

  .hero:not([data-planets]) .hint,
  .hero:not([data-planets]) .tour-btn {
    display: none;
  }

  /* While visiting, the intro and hint step aside for the planet and its panel. */
  .intro,
  .hint {
    transition:
      opacity var(--dur-base) ease,
      transform var(--dur-base) ease,
      visibility 0s linear 0s;
  }

  .hero.is-visiting .intro {
    opacity: 0;
    transform: translateX(-14px);
    visibility: hidden;
    transition:
      opacity var(--dur-base) ease,
      transform var(--dur-base) ease,
      visibility 0s linear var(--dur-base);
  }

  .hero.is-visiting .hint {
    opacity: 0;
    visibility: hidden;
  }

  .hint-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px 20px;
    font-size: var(--s-small);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  /* Global so it also reaches the popover, which belongs to another component's scope. */
  .hint-row > :global(*) {
    pointer-events: auto;
  }

  /* Project pages without the explorer show the static visit; with it, the explorer takes
     over (it removes .visiting) and the static copy steps aside. */
  .hero.visiting .intro,
  .hero.visiting .hint,
  .hero:not(.visiting) .visit-wrap {
    display: none;
  }

  .visit-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* The intro spans the content width; only its own text and buttons take the pointer, so
     the rest of the hero reaches the explorer underneath. */
  .intro {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    pointer-events: none;
    gap: 20px;
    justify-items: start;
  }

  .intro > * {
    max-width: 31rem;
    pointer-events: auto;
  }

  .hero-title {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--s-h1);
    font-weight: 380;
    line-height: 1.07;
    letter-spacing: -0.012em;
  }

  em {
    font-style: italic;
    font-weight: 340;
    color: var(--sol);
  }

  .lede {
    margin: 0;
    max-width: 27rem;
    font-size: var(--s-lede);
    line-height: 1.55;
    color: var(--dim);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 760px) {
    /* Stacked, so the popover opens from the left edge and fits the screen. */
    .hint-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero {
      align-items: start;
      height: clamp(760px, 100svh, 880px);
      padding-top: 88px;
    }

    .intro {
      gap: 14px;
    }

    .lede {
      font-size: var(--s-body);
    }
  }
</style>
