---
// The experience worldline (docs/design-spec.md, "Experience timeline"), drawn at build time
// from the experience and education collections. The list below it carries the same
// information; with JavaScript, roles and the college band become buttons that show their
// entry from that list (src/features/timeline/selection.ts), and "Play the timeline" walks
// through the roles in order (src/features/timeline/playback.ts).
import { site } from '../data/site';
import { layoutTimeline } from '../features/timeline/layout';
import type { Education, Role } from '../lib/content';

interface Props {
  roles: Role[];
  education: Education[];
}

const { roles, education } = Astro.props;
const t = layoutTimeline(roles, education, site.availability);
const laneNames = t.lanes.map(({ label }) => label.toLowerCase());
const laneList = `${laneNames.slice(0, -1).join(', ')} and ${laneNames.at(-1)}`;
const description =
  `Timeline of experience from ${t.span.from} to now in ${laneNames.length} lanes: ${laneList}` +
  `${t.bands.length ? ', with college shaded' : ''} and a future light cone at the present.` +
  ' The roles are listed below.';
const coneX = t.now.x + t.now.cone.width;
---

<div class="timeline">
  <div class="wl-ctl" hidden data-timeline-controls>
    <button class="btn btn-primary" type="button" aria-controls="timeline-chart" data-play>
      Play the timeline
    </button>
    <div class="wl-bar" hidden data-play-bar>
      <span aria-live="polite" data-play-label></span>
      <div class="track" aria-hidden="true">
        <i data-play-fill></i>
      </div>
    </div>
  </div>
  <p class="swipe-hint">Swipe the timeline sideways →</p>
  <div class="figwrap" tabindex="0" role="region" aria-label="Experience timeline">
    <svg
      id="timeline-chart"
      class="wl"
      viewBox={`0 0 ${t.width} ${t.height}`}
      role="img"
      aria-label={description}
      data-timeline
      data-default={`role-${t.latest}`}
      data-left={t.left}
      data-start={t.time.start}
      data-scale={t.time.scale}
      data-now={t.time.now}
    >
      {t.years.map(({ year, x }) => (
        <>
          <line class="grid" x1={x} y1={t.top - 4} x2={x} y2={t.bottom} />
          <text class="year" x={x} y="30" text-anchor="middle">
            {year}
          </text>
        </>
      ))}
      <line class="axis" x1={t.left} y1={t.axis.y} x2={t.axis.x1} y2={t.axis.y} />

      {t.bands.map((band) => (
        <g class="edu" data-entry={`education-${band.id}`} aria-label={band.name}>
          <rect
            class="band"
            x={band.x0}
            y={t.top}
            width={band.x1 - band.x0}
            height={t.bottom - t.top}
          />
          {/* One text with a space between the lines, so it reads as two phrases. */}
          <text class="cold">
            <tspan x={band.x0 + 8} y={t.bottom + 20}>
              {band.label}
            </tspan>{' '}
            <tspan x={band.x0 + 8} y={t.bottom + 35}>
              {band.sublabel}
            </tspan>
          </text>
          <line class="grad" x1={band.x1} y1={t.top} x2={band.x1} y2={t.bottom + 6} />
        </g>
      ))}

      {t.lanes.map(({ label, y }) => (
        <>
          {y.map((rowY) => (
            <line class="lane" x1={t.left} y1={rowY} x2={t.laneEnd} y2={rowY} />
          ))}
          <text class="lane-label" x={t.laneLabelX} y={y[0]! + 4}>
            {label}
          </text>
        </>
      ))}

      <g class="now">
        <polygon
          class="cone"
          points={`${t.now.x},${t.now.y} ${coneX},${t.now.y - t.now.cone.height} ${coneX},${t.now.y + t.now.cone.height}`}
        />
        <text class="sol" x={t.now.labelX} y={t.now.titleY} text-anchor="middle">
          FUTURE LIGHT CONE
        </text>
        {t.now.availability.map(({ text, y }) => (
          <text class="avail" x={t.now.labelX} y={y} text-anchor="middle">
            {text}
          </text>
        ))}
        <line class="now-line" x1={t.now.x} y1={t.top} x2={t.now.x} y2={t.bottom} />
        <text class="sol" x={t.now.x} y="50" text-anchor="middle">
          NOW
        </text>
        {t.now.from !== null && (
          <line class="connector" x1={t.now.from} y1={t.now.y} x2={t.now.x} y2={t.now.y} />
        )}
        <circle class="now-dot" cx={t.now.x} cy={t.now.y} r="5" />
      </g>

      {t.roles.map((role) => (
        <g
          class:list={['wr', { hl: role.highlight }]}
          data-role={role.id}
          data-entry={`role-${role.id}`}
          data-t0={role.t0}
          data-t1={role.t1}
          aria-label={role.name}
        >
          <rect
            class="hit"
            x={role.x0 - 8}
            y={role.y - 26}
            width={Math.max(role.x1 - role.x0, role.labelWidth) + 16}
            height="50"
            rx="3"
          />
          <line class="bar" x1={role.x0} y1={role.y} x2={role.x1} y2={role.y} />
          {/*
            One text with a space between the lines, so its visible text reads "label sublabel"
            and the button's name can start with it (WCAG 2.5.3).
          */}
          <text>
            <tspan class="lab" x={role.x0} y={role.y - 10}>
              {role.label}
            </tspan>{' '}
            <tspan class="sub" x={role.x0} y={role.y + 19}>
              {role.sublabel}
            </tspan>
          </text>
          {/* Rides the end of the bar while playback draws it. */}
          <circle class="head" cx={role.x1} cy={role.y} r="5" />
        </g>
      ))}

      {/* Playback cursor: a line, a tag and the month it has reached. */}
      <g class="cursor" aria-hidden="true">
        <line class="cursor-line" x1="0" y1={t.top - 8} x2="0" y2={t.bottom + 4} />
        <polygon points={`-5,${t.top - 8} 5,${t.top - 8} 0,${t.top - 1}`} />
        <text class="sol" x="9" y="50" />
      </g>
    </svg>
  </div>
</div>

<script>
  import { createPlayback, type Playback } from '../features/timeline/playback';
  import { enhanceTimeline } from '../features/timeline/selection';

  const section = document.querySelector<HTMLElement>('#experience');
  let playback: Playback | null = null;
  const selection = section && enhanceTimeline(section, { onUserSelect: () => playback?.stop() });
  if (section && selection) playback = createPlayback(section, selection);
</script>

<style>
  .timeline {
    margin-bottom: var(--sp-6);
  }

  .swipe-hint {
    display: none;
    margin: 0 0 var(--sp-2);
    font-size: var(--s-small);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .figwrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .figwrap:focus-visible {
    outline: 2px solid var(--sol);
    outline-offset: 4px;
  }

  /* Never drawn smaller than its viewBox, so data labels stay at least 11 px (phones scroll). */
  .wl {
    display: block;
    width: 100%;
    min-width: 960px;
    height: auto;
  }

  /* Small text over the sky: a void stroke behind the glyphs keeps it readable. */
  .year,
  .lane-label,
  .sub,
  .cold,
  .sol {
    paint-order: stroke;
    stroke: var(--void);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .year,
  .sub {
    fill: var(--dim);
    font-family: var(--f-data);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }

  .lane-label {
    fill: var(--dim);
    font-family: var(--f-data);
    font-size: 11.5px;
    letter-spacing: 0.08em;
  }

  .cold {
    fill: var(--cold);
    font-family: var(--f-data);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .sol {
    fill: var(--sol);
    font-family: var(--f-data);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .lab,
  .avail {
    fill: var(--ink);
    font-family: var(--f-body);
    font-size: 14px;
  }

  .axis {
    stroke: var(--faint);
    stroke-width: 1;
  }

  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .lane {
    stroke: var(--rule);
    stroke-dasharray: 2 6;
  }

  .band {
    fill: var(--cold);
    fill-opacity: 0.055;
  }

  .grad {
    stroke: var(--cold);
    stroke-opacity: 0.55;
    stroke-dasharray: 4 4;
  }

  .cone {
    fill: var(--sol);
    fill-opacity: 0.07;
    stroke: var(--sol);
    stroke-opacity: 0.55;
    stroke-dasharray: 4 4;
  }

  .now-line {
    stroke: var(--sol);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    opacity: 0.6;
  }

  .connector {
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-dasharray: 2 4;
  }

  .now-dot {
    fill: var(--sol);
    stroke: var(--sol);
    stroke-width: 1.5;
  }

  .bar {
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .wr.hl .bar {
    stroke: var(--sol);
  }

  /* Invisible but hit-testable, so a role's labels and the space around its bar select it. */
  .hit {
    fill: transparent;
    stroke: none;
    pointer-events: all;
  }

  /* Selection (selection.ts turns the picture into a group of buttons). */
  .wl[role='group'] [data-entry] {
    cursor: pointer;
  }

  .wl [data-entry]:focus {
    outline: none;
  }

  .wl [data-entry]:focus-visible .hit,
  .edu:focus-visible .band {
    stroke: var(--sol);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .wr {
    transition: opacity var(--dur-base) ease;
  }

  .bar {
    transition: stroke-width var(--dur-base) ease;
  }

  .band {
    transition: fill-opacity var(--dur-fast) ease;
  }

  .wr.is-selected .bar {
    stroke-width: 7;
  }

  /* Playback (playback.ts). */
  .wl-ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    margin-bottom: 18px;
    scroll-margin-top: var(--scroll-offset);
  }

  .wl-ctl[hidden],
  .wl-bar[hidden] {
    display: none;
  }

  .wl-bar {
    display: grid;
    flex: 1 1 220px;
    max-width: 26rem;
    gap: 6px;
    font-family: var(--f-data);
    font-size: var(--s-cap);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .track {
    height: 2px;
    overflow: hidden;
    background: var(--rule);
  }

  .track i {
    display: block;
    height: 100%;
    background: var(--sol);
    transform: scaleX(0);
    transform-origin: left;
  }

  .track i.is-running {
    animation: wl-fill linear forwards;
  }

  @keyframes wl-fill {
    to {
      transform: scaleX(1);
    }
  }

  .cursor {
    opacity: 0;
    transition: opacity var(--dur-fast);
  }

  .cursor polygon {
    fill: var(--sol);
  }

  .cursor-line {
    stroke: var(--sol);
    stroke-opacity: 0.85;
  }

  .wl.is-playing .cursor {
    opacity: 1;
  }

  .head {
    fill: var(--sol);
    stroke: var(--void);
    stroke-width: 2;
    opacity: 0;
    transition: opacity var(--dur-fast);
  }

  .wl.is-playing .wr.is-live .head {
    opacity: 1;
  }

  .wr.is-future {
    opacity: 0.07 !important;
  }

  .now {
    transition: opacity var(--dur-base);
  }

  .wl.is-playing .now {
    opacity: 0;
  }

  /* The label still says where playback is; the bar does not move. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      display: none;
    }
  }

  .wl.has-selection .wr:not(.is-selected) {
    opacity: 0.86;
  }

  .wl[role='group'] .edu:hover .band,
  .edu.is-selected .band {
    fill-opacity: 0.1;
  }

  /* The figure's frame is 960 px plus the gutters; below that it scrolls. */
  @media (max-width: 991px) {
    .swipe-hint {
      display: block;
    }
  }
</style>
