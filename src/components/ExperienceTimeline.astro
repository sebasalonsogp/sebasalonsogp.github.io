---
// The experience worldline (docs/design-spec.md, "Experience timeline"), drawn at build time
// from the experience and education collections. The list below it carries the same
// information for screen readers and anyone who prefers text.
import { site } from '../data/site';
import { layoutTimeline } from '../features/timeline/layout';
import type { Education, Role } from '../lib/content';

interface Props {
  roles: Role[];
  education: Education[];
}

const { roles, education } = Astro.props;
const t = layoutTimeline(roles, education, site.availability);
const laneNames = t.lanes.map(({ label }) => label.toLowerCase());
const laneList = `${laneNames.slice(0, -1).join(', ')} and ${laneNames.at(-1)}`;
const description =
  `Timeline of experience from ${t.span.from} to now in ${laneNames.length} lanes: ${laneList}` +
  `${t.bands.length ? ', with college shaded' : ''} and a future light cone at the present.` +
  ' The roles are listed below.';
const coneX = t.now.x + t.now.cone.width;
---

<div class="timeline">
  <p class="swipe-hint">Swipe the timeline sideways →</p>
  <div class="figwrap" tabindex="0" role="region" aria-label="Experience timeline">
    <svg class="wl" viewBox={`0 0 ${t.width} ${t.height}`} role="img" aria-label={description}>
      {t.years.map(({ year, x }) => (
        <>
          <line class="grid" x1={x} y1={t.top - 4} x2={x} y2={t.bottom} />
          <text class="year" x={x} y="30" text-anchor="middle">
            {year}
          </text>
        </>
      ))}
      <line class="axis" x1={t.left} y1={t.axis.y} x2={t.axis.x1} y2={t.axis.y} />

      {t.bands.map((band) => (
        <g class="edu" data-education={band.id}>
          <rect
            class="band"
            x={band.x0}
            y={t.top}
            width={band.x1 - band.x0}
            height={t.bottom - t.top}
          />
          <text class="cold" x={band.x0 + 8} y={t.bottom + 20}>
            {band.label}
          </text>
          <text class="cold" x={band.x0 + 8} y={t.bottom + 35}>
            {band.sublabel}
          </text>
          <line class="grad" x1={band.x1} y1={t.top} x2={band.x1} y2={t.bottom + 6} />
        </g>
      ))}

      {t.lanes.map(({ label, y }) => (
        <>
          {y.map((rowY) => (
            <line class="lane" x1={t.left} y1={rowY} x2={t.laneEnd} y2={rowY} />
          ))}
          <text class="lane-label" x={t.laneLabelX} y={y[0]! + 4}>
            {label}
          </text>
        </>
      ))}

      <g class="now">
        <polygon
          class="cone"
          points={`${t.now.x},${t.now.y} ${coneX},${t.now.y - t.now.cone.height} ${coneX},${t.now.y + t.now.cone.height}`}
        />
        <text class="sol" x={t.now.labelX} y={t.now.titleY} text-anchor="middle">
          FUTURE LIGHT CONE
        </text>
        {t.now.availability.map(({ text, y }) => (
          <text class="avail" x={t.now.labelX} y={y} text-anchor="middle">
            {text}
          </text>
        ))}
        <line class="now-line" x1={t.now.x} y1={t.top} x2={t.now.x} y2={t.bottom} />
        <text class="sol" x={t.now.x} y="50" text-anchor="middle">
          NOW
        </text>
        {t.now.from !== null && (
          <line class="connector" x1={t.now.from} y1={t.now.y} x2={t.now.x} y2={t.now.y} />
        )}
        <circle class="now-dot" cx={t.now.x} cy={t.now.y} r="5" />
      </g>

      {t.roles.map((role) => (
        <g class:list={['wr', { hl: role.highlight }]} data-role={role.id}>
          <line class="bar" x1={role.x0} y1={role.y} x2={role.x1} y2={role.y} />
          <text class="lab" x={role.x0} y={role.y - 10}>
            {role.label}
          </text>
          <text class="sub" x={role.x0} y={role.y + 19}>
            {role.sublabel}
          </text>
        </g>
      ))}
    </svg>
  </div>
</div>

<style>
  .timeline {
    margin-bottom: var(--sp-6);
  }

  .swipe-hint {
    display: none;
    margin: 0 0 var(--sp-2);
    font-size: var(--s-small);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .figwrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .figwrap:focus-visible {
    outline: 2px solid var(--sol);
    outline-offset: 4px;
  }

  /* Never drawn smaller than its viewBox, so data labels stay at least 11 px (phones scroll). */
  .wl {
    display: block;
    width: 100%;
    min-width: 960px;
    height: auto;
  }

  /* Small text over the sky: a void stroke behind the glyphs keeps it readable. */
  .year,
  .lane-label,
  .sub,
  .cold,
  .sol {
    paint-order: stroke;
    stroke: var(--void);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .year,
  .sub {
    fill: var(--dim);
    font-family: var(--f-data);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }

  .lane-label {
    fill: var(--dim);
    font-family: var(--f-data);
    font-size: 11.5px;
    letter-spacing: 0.08em;
  }

  .cold {
    fill: var(--cold);
    font-family: var(--f-data);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .sol {
    fill: var(--sol);
    font-family: var(--f-data);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .lab,
  .avail {
    fill: var(--ink);
    font-family: var(--f-body);
    font-size: 14px;
  }

  .axis {
    stroke: var(--faint);
    stroke-width: 1;
  }

  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .lane {
    stroke: var(--rule);
    stroke-dasharray: 2 6;
  }

  .band {
    fill: var(--cold);
    fill-opacity: 0.055;
  }

  .grad {
    stroke: var(--cold);
    stroke-opacity: 0.55;
    stroke-dasharray: 4 4;
  }

  .cone {
    fill: var(--sol);
    fill-opacity: 0.07;
    stroke: var(--sol);
    stroke-opacity: 0.55;
    stroke-dasharray: 4 4;
  }

  .now-line {
    stroke: var(--sol);
    stroke-width: 1;
    stroke-dasharray: 3 5;
    opacity: 0.6;
  }

  .connector {
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-dasharray: 2 4;
  }

  .now-dot {
    fill: var(--sol);
    stroke: var(--sol);
    stroke-width: 1.5;
  }

  .bar {
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .wr.hl .bar {
    stroke: var(--sol);
  }

  /* The figure's frame is 960 px plus the gutters; below that it scrolls. */
  @media (max-width: 991px) {
    .swipe-hint {
      display: block;
    }
  }
</style>
