---
// The skills constellation (docs/design-spec.md, "Skills constellation"), drawn at build time
// from the skills the projects and roles use, beside an overview of them. The list below it
// carries the same information as text. With JavaScript, stars become buttons that light up
// the skills used with them and list where (src/features/constellation/selection.ts).
import { domains } from '../data/taxonomy';
import { layoutConstellation } from '../features/constellation/layout';
import type { ConstellationData } from '../features/constellation/selection';
import { withBase } from '../lib/format';
import type { SkillGroupUse, SkillUse } from '../lib/skills';

interface Props {
  core: SkillUse | undefined;
  groups: SkillGroupUse[];
  total: number;
  projectCount: number;
  roleCount: number;
}

const { core, groups, total, projectCount, roleCount } = Astro.props;
const c = layoutConstellation(core, groups);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const mostUsed = [...(core ? [core] : []), ...groups.flatMap((g) => g.skills)]
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 6);
const allSkills = [...(core ? [core] : []), ...groups.flatMap((g) => g.skills)];
// What the panel lists for each skill, and the skills used alongside it.
const data: ConstellationData = {
  skills: Object.fromEntries(
    allSkills.map((skill) => {
      const together = new Set([
        ...skill.projects.flatMap((p) => p.data.tech),
        ...skill.roles.flatMap((r) => r.data.skills),
      ]);
      together.delete(skill.name);
      return [
        skill.name,
        {
          count: skill.count,
          projects: skill.projects.map((p) => ({
            id: p.id,
            title: p.data.title,
            href: withBase(`projects/${p.id}/`),
            color: domains[p.data.domain].color,
          })),
          roles: skill.roles.map((r) => ({
            entry: `role-${r.id}`,
            title: `${r.data.title}, ${r.data.orgShort}`,
          })),
          with: [...together],
        },
      ];
    }),
  ),
  groups: groups.map((g) => g.skills.map((skill) => skill.name)),
  projectCount,
  roleCount,
};
const description =
  `Skills constellation: ${plural(total, 'skill')} in ${plural(groups.length, 'group')}` +
  `${core ? `, with ${core.name} at the centre` : ''}. Bigger stars are used in more places.` +
  ' The skills are listed below.';
---

<div class="c-ctl" hidden data-constellation-controls>
  <div class="seg" role="group" aria-label="Show skills from">
    <button type="button" data-filter="all" aria-pressed="true">
      All
    </button>
    <button type="button" data-filter="project" aria-pressed="false">
      Projects
    </button>
    <button type="button" data-filter="role" aria-pressed="false">
      Experience
    </button>
  </div>
</div>
<div class="skills-figure">
  <div class="chart">
    <p class="swipe-hint">Swipe the constellation sideways →</p>
    <div class="figwrap" tabindex="0" role="region" aria-label="Skills constellation">
      <svg
        class="cn"
        viewBox={`0 0 ${c.width} ${c.height}`}
        role="img"
        aria-label={description}
        data-constellation
      >
        <g class="links">
          {c.lines.map((l) => (
            <line
              x1={l.x1.toFixed(1)}
              y1={l.y1.toFixed(1)}
              x2={l.x2.toFixed(1)}
              y2={l.y2.toFixed(1)}
            />
          ))}
        </g>
        {c.groups.map((g) => (
          <text class="group-label" x={g.x.toFixed(1)} y={g.y.toFixed(1)} text-anchor="middle">
            {g.name}
          </text>
        ))}
        {c.stars.map((star) => (
          <g
            class:list={['star', { major: star.major }]}
            data-skill={star.name}
            aria-label={`${star.name}: ${plural(star.projects, 'project')}, ${plural(star.roles, 'role')}`}
          >
            <rect
              class="hit"
              x={star.box.x.toFixed(1)}
              y={star.box.y.toFixed(1)}
              width={star.box.width.toFixed(1)}
              height={star.box.height.toFixed(1)}
              rx="3"
            />
            <circle class="halo" cx={star.x.toFixed(1)} cy={star.y.toFixed(1)} r={star.r * 2.6} />
            {star.projects > 0 && star.roles > 0 && (
              <circle class="ring" cx={star.x.toFixed(1)} cy={star.y.toFixed(1)} r={star.r + 3.5} />
            )}
            <circle
              class:list={['core', { hollow: star.projects === 0 }]}
              cx={star.x.toFixed(1)}
              cy={star.y.toFixed(1)}
              r={star.r.toFixed(2)}
            />
            <text
              x={(star.labelLeft ? star.x - star.r - 8 : star.x + star.r + 8).toFixed(1)}
              y={(star.y + 4.5).toFixed(1)}
              text-anchor={star.labelLeft ? 'end' : 'start'}
            >
              {star.name}
            </text>
          </g>
        ))}
      </svg>
    </div>
  </div>

  <div class="overview" id="constellation-panel" data-panel>
    <div class="panel-head">
      <p class="eyebrow" data-panel-eyebrow>
        Overview
      </p>
      <button class="clear" type="button" hidden data-panel-clear>
        Clear ×
      </button>
    </div>
    <h3 data-panel-title>{plural(total, 'skill')}</h3>
    <p class="mono" data-panel-count>
      {plural(groups.length, 'group')} · from {plural(projectCount, 'project')} and{' '}
      {plural(roleCount, 'role')}
    </p>
    <ul data-panel-list>
      <li class="list-head">Most used</li>
      {mostUsed.map((skill) => (
        <li>
          <i class:list={['ico', { role: skill.projects.length === 0 }]} aria-hidden="true" />
          {skill.name} · {skill.count}
        </li>
      ))}
    </ul>
  </div>
</div>
<script
  type="application/json"
  data-constellation-data
  set:html={JSON.stringify(data).replace(/</g, '\u003c')}
/>
<script>
  import { enhanceConstellation } from '../features/constellation/selection';

  const section = document.querySelector<HTMLElement>('#skills');
  if (section) enhanceConstellation(section);
</script>

<style>
  .skills-figure {
    display: grid;
    grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    margin-bottom: var(--sp-6);
  }

  .swipe-hint {
    display: none;
    margin: 0 0 var(--sp-2);
    font-size: var(--s-small);
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .figwrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .figwrap:focus-visible {
    outline: 2px solid var(--sol);
    outline-offset: 4px;
  }

  /* 14-unit labels stay at least 12 px: never drawn narrower than 772 px (phones scroll). */
  .cn {
    display: block;
    width: 100%;
    min-width: 772px;
    height: auto;
  }

  .links line {
    stroke: var(--dim);
    stroke-opacity: 0.38;
    stroke-width: 1;
  }

  text {
    paint-order: stroke;
    stroke: var(--void);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .group-label {
    fill: var(--dim);
    font-family: var(--f-data);
    font-size: 14px;
    letter-spacing: 0.16em;
  }

  .star text {
    fill: color-mix(in srgb, var(--ink) 82%, var(--dim));
    font-family: var(--f-body);
    font-size: 14px;
  }

  .star.major text {
    fill: var(--ink);
    font-weight: 500;
  }

  .core {
    fill: var(--ink);
  }

  .core.hollow {
    fill: var(--void);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .ring {
    fill: none;
    stroke: var(--cold);
    stroke-width: 1.2;
    opacity: 0.85;
  }

  .overview {
    display: grid;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .overview p,
  .overview h3,
  .overview ul {
    margin: 0;
  }

  .overview h3 {
    font-size: 2rem;
    font-weight: 400;
  }

  .overview .mono {
    text-transform: uppercase;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .clear {
    padding: 4px 0;
    border: 0;
    background: none;
    font-family: var(--f-data);
    font-size: var(--s-cap);
    color: var(--dim);
    cursor: pointer;
  }

  .clear:hover {
    color: var(--ink);
  }

  .clear[hidden] {
    display: none;
  }

  /* The list is rebuilt by selection.ts, so its items are styled globally within the panel. */
  .overview ul {
    display: grid;
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .overview :global(.list-head) {
    margin-top: 8px;
    font-family: var(--f-data);
    font-size: var(--s-cap);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    text-shadow: var(--halo);
  }

  .overview :global(li:not(.list-head)) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 6px 0;
  }

  .overview :global(li > button),
  .overview :global(li > a) {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .overview :global(li > button:hover),
  .overview :global(li > a:hover) {
    color: var(--sol);
  }

  .overview :global(.ico) {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
  }

  .overview :global(.ico.role) {
    border: 1.5px solid var(--ink);
    background: transparent;
  }

  /* Filter (selection.ts shows it). */
  .c-ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-bottom: 18px;
  }

  .c-ctl[hidden] {
    display: none;
  }

  .seg {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--faint);
    border-radius: var(--radius-1);
  }

  .seg button {
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    background: none;
    color: var(--dim);
    font-size: var(--s-small);
    cursor: pointer;
  }

  .seg button + button {
    border-left: 1px solid var(--faint);
  }

  .seg button[aria-pressed='true'] {
    background: color-mix(in srgb, var(--sol) 16%, transparent);
    color: var(--ink);
  }

  /* Selection states (selection.ts). */
  .hit {
    fill: transparent;
    stroke: none;
    pointer-events: all;
  }

  .halo {
    fill: var(--sol);
    opacity: 0;
    transition: opacity var(--dur-fast);
  }

  .cn[role='group'] .star {
    cursor: pointer;
  }

  .star:focus {
    outline: none;
  }

  .star:focus-visible .hit {
    stroke: var(--sol);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .cn[role='group'] .star:hover .halo {
    opacity: 0.12;
  }

  .star.is-selected .halo {
    opacity: 0.22;
  }

  .star.is-selected .core {
    fill: var(--sol);
  }

  .star.is-selected .core.hollow {
    fill: var(--void);
    stroke: var(--sol);
  }

  .star.is-selected text {
    fill: var(--sol);
  }

  .star {
    transition: opacity var(--dur-fast);
  }

  .cn.has-selection .star:not(.is-selected):not(.is-near) {
    opacity: 0.24;
  }

  .cn.has-selection .star.is-near text {
    fill: var(--ink);
  }

  .cn.has-selection .links line {
    stroke-opacity: 0.14;
  }

  .cn.has-selection .group-label {
    opacity: 0.45;
  }

  .star.is-off {
    opacity: 0.12 !important;
    pointer-events: none;
  }

  .links line.is-off {
    opacity: 0.15;
  }

  /* The chart needs 772 px beside its panel; narrower screens stack them. */
  @media (max-width: 1179px) {
    .skills-figure {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Below 772 px plus the gutters the chart scrolls. */
  @media (max-width: 803px) {
    .swipe-hint {
      display: block;
    }
  }
</style>
