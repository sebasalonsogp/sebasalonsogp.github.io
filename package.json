{
  "name": "personal-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run build && npm run budgets",
    "test": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og": "astro build && node scripts/og-images.mjs",
    "icons": "node scripts/icons.mjs",
    "sync:github": "node scripts/sync-github.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
